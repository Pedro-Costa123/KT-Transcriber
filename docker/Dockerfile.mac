# macOS Docker image.
# Docker Desktop runs this container without CUDA/Metal acceleration;
# faster-whisper and pyannote use CPU for predictable compatibility.
# The official Python image is multi-architecture, so Apple Silicon builds ARM64
# and Intel Macs build AMD64 without changing this file.
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/root/.cache/huggingface

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-diarization.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && python -m pip install --no-cache-dir -r requirements-diarization.txt

COPY kt_transcribe.py technical_terms.txt ./

ENTRYPOINT ["python", "/app/kt_transcribe.py"]
